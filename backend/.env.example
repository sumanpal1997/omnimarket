PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (Replace with your local MongoDB URI or free cloud MongoDB Atlas cluster URI)
MONGODB_URI=mongodb://localhost:27017/omnimarket

# JWT Security Secrets (Must be at least 32 characters)
JWT_ACCESS_SECRET=super_secret_jwt_access_key_min_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_67890
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Secret (Must be at least 16 characters)
COOKIE_SECRET=super_cookie_secret_16_chars_min

# Marketplace Settings
DEFAULT_CURRENCY=INR
DEFAULT_PLATFORM_COMMISSION_PERCENT=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
